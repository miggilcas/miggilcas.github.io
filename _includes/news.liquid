{%- comment -%} Local override of al_folio_core 1.0.15 news.liquid: shows `es:` text and local date format on Spanish pages. {%- endcomment -%}
{%- assign cur_lang = page.lang | default: 'en' -%}
{%- assign t = site.data.i18n[cur_lang] -%}
<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: t.date_format }}</th>
            <td>
              {% if item.inline and cur_lang == 'es' and item.es %}
                {{ item.es | markdownify | remove: '<p>' | remove: '</p>' | emojify }}
              {% elsif item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
